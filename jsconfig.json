{
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "skipLibCheck": true,
    "lib": [
      "es2023",
      "dom",
      "dom.iterable"
    ],
    "jsx": "preserve",
    "types": [],
    "baseUrl": "."
  },
  "include": [
    "app/lib/*.js",
    "app/lib/*.d.ts",
    "shared/*.mjs"
  ],
  "exclude": [
    "app/lib/use-*.js"
  ]
}
