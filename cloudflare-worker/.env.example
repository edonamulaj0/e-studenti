# Example Environment Variables
# Copy this file to .env.local and fill in your values

# Your deployed Cloudflare Worker URL
WORKER_URL=https://r2-catalog-manager.your-subdomain.workers.dev

# Your R2 bucket name
R2_BUCKET_NAME=your-bucket-name

# Your R2 public URL base
R2_PUBLIC_URL=https://media.e-studenti.com

# Optional: Admin panel authentication (future implementation)
# ADMIN_PASSWORD=your-secure-password

# Optional: API key for worker (future implementation)
# API_KEY=your-api-key
