# Example local environment variables.
# Never commit real credentials. Production values must be Wrangler secrets.

JWT_SECRET=replace-with-random-64-character-secret
RESEND_API_KEY=re_00000000000000000000000000000000
RESEND_FROM=E-Studenti <onboarding@resend.dev>
RESEND_VERIFY_FROM=E-Studenti <onboarding@resend.dev>
RESEND_CONTACT_FROM=E-Studenti <onboarding@resend.dev>
ADMIN_EMAIL=optional-admin-inbox@example.com

ALLOWED_ORIGINS=https://e-studenti.com,https://www.e-studenti.com,https://e-studenti.pages.dev
JWT_ISSUER=https://e-studenti.com
JWT_AUDIENCE=https://e-studenti.com
GOOGLE_SAFE_BROWSING_API_KEY=optional-google-safe-browsing-api-key
# Optional: Cloudflare Pages deploy hook; set with `wrangler secret put PAGES_DEPLOY_HOOK`.
# Lets the Worker request a rebuild when the catalogue changes (see docs/DEPLOYMENT.md).
PAGES_DEPLOY_HOOK=https://api.cloudflare.com/client/v4/pages/webhooks/deploy_hooks/replace-me
