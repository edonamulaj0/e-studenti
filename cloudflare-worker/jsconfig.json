{
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "skipLibCheck": true,
    "lib": [
      "es2023"
    ],
    "types": [
      "@cloudflare/workers-types"
    ]
  },
  "include": [
    "src/*.js",
    "../shared/*.mjs"
  ],
  "exclude": [
    "src/*.test.js"
  ]
}
