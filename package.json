{
	"name": "e-studenti",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"dev": "next dev",
		"dev:worker": "npm --prefix cloudflare-worker run dev",
		"build": "node scripts/generate-sitemap.mjs && next build && node scripts/og-image-extensions.mjs && node scripts/csp-inline-hashes.mjs && node scripts/scan-client-secrets.mjs",
		"scan-secrets": "node scripts/scan-client-secrets.mjs",
		"lint": "eslint .",
		"typecheck": "tsc -p jsconfig.json && tsc -p cloudflare-worker/jsconfig.json",
		"test": "npm --prefix cloudflare-worker test",
		"check": "npm run lint && npm run typecheck && npm test",
		"sync-erasmus": "node scripts/sync-erasmus.mjs",
		"stub-api": "node scripts/stub-api.mjs",
		"test:e2e": "node --test tests/e2e/*.test.mjs",
		"db:local": "npm --prefix cloudflare-worker run db:local"
	},
	"dependencies": {
		"@aiden0z/pptx-renderer": "^1.2.4",
		"docx-preview": "^0.4.0",
		"framer-motion": "^12.38.0",
		"jszip": "^3.10.1",
		"lucide-react": "^0.263.1",
		"next": "^15.5.22",
		"pdfjs-dist": "^6.2.108",
		"react": "^18.3.1",
		"react-dom": "^18.3.1",
		"recharts": "^2.15.4",
		"xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
	},
	"overrides": {
		"postcss": "$postcss",
		"sharp": "^0.35.5",
		"brace-expansion": "5.0.12",
		"postcss-selector-parser": "^7.1.7"
	},
	"browserslist": [
		"chrome >= 93",
		"firefox >= 92",
		"safari >= 15",
		"edge >= 93"
	],
	"devDependencies": {
		"@eslint/eslintrc": "^3.3.0",
		"@fontsource/montserrat": "^5.3.0",
		"@fontsource/playfair-display": "^5.3.0",
		"autoprefixer": "^10.0.1",
		"critters": "^0.0.23",
		"eslint": "^9.39.0",
		"eslint-config-next": "^15.5.0",
		"playwright": "^1.59.1",
		"postcss": "^8.5.23",
		"tailwindcss": "^3.3.0",
		"typescript": "^5.9.0"
	},
	"engines": {
		"node": ">=20"
	}
}
